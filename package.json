{
  "name": "paperback-manga-sources",
  "version": "1.0.0",
  "private": true,
  "repositoryName": "Paperback Manga Sources",
  "description": "Paperback v0.8 source repository for multiple manga scan sites.",
  "scripts": {
    "generate-version": "node scripts/generate-version.js",
    "test": "tsx --test tests/parsers.test.ts",
    "test:live": "tsx scripts/smoke-tests.ts",
    "pretest:metadata": "npm run generate-version",
    "test:metadata": "tsx --test tests/metadata.live.test.ts",
    "metadata-interactif": "node scripts/run-metadata-interactive.js",
    "pretypecheck": "npm run generate-version",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run generate-version",
    "build": "paperback bundle",
    "postbuild": "node scripts/generate-source-metadata.js",
    "prebundle": "npm run generate-version",
    "bundle": "paperback bundle",
    "preserve": "npm run generate-version",
    "serve": "paperback serve"
  },
  "keywords": [
    "paperback",
    "paperback-extension",
    "omegascans",
    "mangadistrict",
    "poseidon-scans",
    "lelmanga",
    "epsilonsoft",
    "astral-manga",
    "mangas-origines-2026"
  ],
  "license": "MIT",
  "devDependencies": {
    "@paperback/toolchain": "0.8.0-alpha.38",
    "@paperback/types": "0.8.0-alpha.38",
    "@types/node": "^18.11.9",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^4.8.3"
  }
}
